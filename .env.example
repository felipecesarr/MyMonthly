EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional subscriptions. Use the RevenueCat Test Store public SDK key in local
# development. Release builds use the platform-specific public SDK keys.
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Optional public Logo.dev image-CDN key; never use a secret key here.
EXPO_PUBLIC_LOGO_DEV_TOKEN=
