{
  "expo": {
    "name": "MyMonthly",
    "slug": "mymonthly",
    "scheme": "mymonthly",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mymonthly.mymontlhy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-iconn.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mymonthly.mymontlhy"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "42eac6cb-f2cc-4e5f-8009-112b8efc80a7"
      }
    },
    "owner": "mymonthly",
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#820AD1",
          "defaultChannel": "daily-reminders"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow MyMonthly to access reports saved to your photo library.",
          "savePhotosPermission": "Allow MyMonthly to save financial reports to your photo library."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
